@model SchoolPortal.Grades.Models.Grade

@{
    ViewData["Title"] = "Grade Details";
    var gradeLevel = Model.Score >= 90 ? "A" : Model.Score >= 80 ? "B" : Model.Score >= 70 ? "C" : Model.Score >= 60 ? "D" : "F";
    var gradeColor = Model.Score >= 90 ? "from-green-400 to-emerald-500" : Model.Score >= 80 ? "from-cyan-400 to-blue-500" : Model.Score >= 70 ? "from-yellow-400 to-orange-500" : Model.Score >= 60 ? "from-orange-400 to-red-500" : "from-red-400 to-pink-500";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex items-center space-x-4 mb-8">
        <a asp-action="Index" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 transition-colors">
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
        </a>
        <div>
            <h1 class="text-3xl font-black">
                <span class="gradient-text">Grade Details</span>
            </h1>
            <p class="text-gray-400 text-sm">View complete grade information</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Score Card -->
        <div class="glass rounded-2xl overflow-hidden">
            <div class="h-2 bg-gradient-to-r @gradeColor"></div>
            <div class="p-8 text-center">
                <div class="relative inline-block mb-6">
                    <svg class="w-48 h-48" viewBox="0 0 100 100">
                        <defs>
                            <linearGradient id="scoreGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#00ffff"/>
                                <stop offset="50%" stop-color="#bf00ff"/>
                                <stop offset="100%" stop-color="#ff00ff"/>
                            </linearGradient>
                        </defs>
                        <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="10"/>
                        <circle cx="50" cy="50" r="45" fill="none" stroke="url(#scoreGradient)" stroke-width="10" stroke-linecap="round" stroke-dasharray="@((double)Model.Score * 2.83) 283" transform="rotate(-90 50 50)"/>
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-5xl font-black gradient-text">@Model.Score</span>
                        <span class="text-gray-400 text-sm">out of 100</span>
                    </div>
                </div>

                <!-- Grade Letter -->
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-gradient-to-br @gradeColor mb-4">
                    <span class="text-4xl font-black text-white">@gradeLevel</span>
                </div>
                <p class="text-gray-400">
                    @(Model.Score >= 90 ? "Excellent Performance!" : Model.Score >= 80 ? "Great Work!" : Model.Score >= 70 ? "Good Effort!" : Model.Score >= 60 ? "Keep Improving!" : "Needs Improvement")
                </p>
            </div>
        </div>

        <!-- Info Card -->
        <div class="glass rounded-2xl overflow-hidden">
            <div class="h-2 bg-gradient-to-r from-cyan-500 via-purple-500 to-pink-500"></div>
            <div class="p-8 space-y-6">
                <h2 class="text-xl font-bold text-white mb-6">Grade Information</h2>

                <!-- Course -->
                <div class="flex items-start space-x-4 p-4 rounded-xl bg-white/5">
                    <div class="w-10 h-10 rounded-lg bg-cyan-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-gray-400 text-sm">Course Name</p>
                        <p class="text-white font-medium">@Model.CourseName</p>
                    </div>
                </div>

                <!-- Student -->
                <div class="flex items-start space-x-4 p-4 rounded-xl bg-white/5">
                    <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-gray-400 text-sm">Student ID</p>
                        <p class="text-white font-medium">@Model.StudentId</p>
                    </div>
                </div>

                <!-- Date -->
                <div class="flex items-start space-x-4 p-4 rounded-xl bg-white/5">
                    <div class="w-10 h-10 rounded-lg bg-pink-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-gray-400 text-sm">Grade Date</p>
                        <p class="text-white font-medium">@Model.GradeDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                </div>

                <!-- ID -->
                <div class="flex items-start space-x-4 p-4 rounded-xl bg-white/5">
                    <div class="w-10 h-10 rounded-lg bg-green-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-gray-400 text-sm">Record ID</p>
                        <p class="text-white font-medium">#@Model.Id</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-cyber flex-1 flex items-center justify-center space-x-2 px-6 py-4 rounded-xl bg-gradient-to-r from-cyan-500 to-purple-500 text-white font-semibold hover:shadow-lg hover:shadow-cyan-500/25 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            <span>Edit Grade</span>
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="flex-1 flex items-center justify-center space-x-2 px-6 py-4 rounded-xl bg-red-500/20 border border-red-500/30 text-red-400 font-semibold hover:bg-red-500/30 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            <span>Delete Grade</span>
        </a>
        <a asp-action="Index" class="flex-1 flex items-center justify-center space-x-2 px-6 py-4 rounded-xl bg-white/5 border border-white/10 text-white font-semibold hover:bg-white/10 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
            </svg>
            <span>All Grades</span>
        </a>
    </div>
</div>
