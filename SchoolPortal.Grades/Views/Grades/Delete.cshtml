@model SchoolPortal.Grades.Models.Grade

@{
    ViewData["Title"] = "Delete Grade";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-red-500 to-pink-500 mb-6 animate-pulse-glow">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
        </div>
        <h1 class="text-4xl font-black mb-4">
            <span class="text-red-400">Delete Grade</span>
        </h1>
        <p class="text-gray-400">Are you sure you want to delete this grade?</p>
    </div>

    <!-- Warning Card -->
    <div class="bg-red-500/10 border border-red-500/30 rounded-2xl p-6 mb-8">
        <div class="flex items-start space-x-4">
            <div class="flex-shrink-0">
                <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
            <div>
                <h3 class="text-red-400 font-semibold">Warning</h3>
                <p class="text-gray-400 text-sm mt-1">This action cannot be undone. The grade record will be permanently deleted from the database.</p>
            </div>
        </div>
    </div>

    <!-- Grade Info Card -->
    <div class="glass rounded-2xl overflow-hidden">
        <div class="h-1 bg-gradient-to-r from-red-500 via-pink-500 to-purple-500"></div>
        <div class="p-8">
            <h2 class="text-xl font-bold text-white mb-6">Grade Information</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Course Name -->
                <div class="p-4 rounded-xl bg-white/5">
                    <p class="text-gray-400 text-sm mb-1">Course Name</p>
                    <p class="text-white font-medium text-lg">@Model.CourseName</p>
                </div>

                <!-- Score -->
                <div class="p-4 rounded-xl bg-white/5">
                    <p class="text-gray-400 text-sm mb-1">Score</p>
                    <p class="text-2xl font-bold gradient-text">@Model.Score</p>
                </div>

                <!-- Student ID -->
                <div class="p-4 rounded-xl bg-white/5">
                    <p class="text-gray-400 text-sm mb-1">Student ID</p>
                    <p class="text-white font-medium">@Model.StudentId</p>
                </div>

                <!-- Date -->
                <div class="p-4 rounded-xl bg-white/5">
                    <p class="text-gray-400 text-sm mb-1">Grade Date</p>
                    <p class="text-white font-medium">@Model.GradeDate.ToString("MMMM dd, yyyy")</p>
                </div>
            </div>

            <!-- Delete Form -->
            <form asp-action="Delete" class="mt-8">
                <input type="hidden" asp-for="Id" />
                <div class="flex flex-col sm:flex-row gap-4">
                    <button type="submit" value="Delete" class="btn-cyber flex-1 flex items-center justify-center space-x-2 px-6 py-4 rounded-xl bg-gradient-to-r from-red-500 to-pink-500 text-white font-semibold hover:shadow-lg hover:shadow-red-500/25 transition-all duration-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        <span>Yes, Delete Grade</span>
                    </button>
                    <a asp-action="Index" class="flex-1 flex items-center justify-center space-x-2 px-6 py-4 rounded-xl bg-white/5 border border-white/10 text-white font-semibold hover:bg-white/10 transition-all duration-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                        <span>No, Keep It</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
