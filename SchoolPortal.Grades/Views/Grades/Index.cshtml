@model IEnumerable<SchoolPortal.Grades.Models.Grade>

@{
    ViewData["Title"] = "Grades Dashboard";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Section -->
    <div class="text-center mb-12">
        <h1 class="text-4xl md:text-6xl font-black mb-4">
            <span class="gradient-text">Grades Dashboard</span>
        </h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">
            Track and manage academic performance with our futuristic grade management system
        </p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="glass rounded-2xl p-6 card-hover">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm uppercase tracking-wider">Total Grades</p>
                    <p class="text-3xl font-bold text-white mt-1">@Model.Count()</p>
                </div>
                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-cyan-500/20 to-cyan-500/5 flex items-center justify-center">
                    <svg class="w-7 h-7 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="glass rounded-2xl p-6 card-hover">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm uppercase tracking-wider">Average Score</p>
                    <p class="text-3xl font-bold text-white mt-1">@(Model.Any() ? Model.Average(g => g.Score).ToString("F1") : "0")</p>
                </div>
                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-purple-500/20 to-purple-500/5 flex items-center justify-center">
                    <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="glass rounded-2xl p-6 card-hover">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm uppercase tracking-wider">Highest Score</p>
                    <p class="text-3xl font-bold text-white mt-1">@(Model.Any() ? Model.Max(g => g.Score).ToString("F1") : "0")</p>
                </div>
                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-pink-500/20 to-pink-500/5 flex items-center justify-center">
                    <svg class="w-7 h-7 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4">
        <div class="flex items-center space-x-2 text-gray-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/>
            </svg>
            <span>Sorted by Date</span>
        </div>
        <a asp-action="Create" class="btn-cyber group flex items-center space-x-2 px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-purple-500 text-white font-semibold hover:shadow-lg hover:shadow-cyan-500/25 transition-all duration-300">
            <svg class="w-5 h-5 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Add New Grade</span>
        </a>
    </div>

    <!-- Grades Grid -->
    @if (Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model.OrderByDescending(g => g.GradeDate))
            {
                <div class="glass rounded-2xl overflow-hidden card-hover group">
                    <!-- Card Header with gradient -->
                    <div class="h-2 bg-gradient-to-r from-cyan-500 via-purple-500 to-pink-500"></div>
                    
                    <div class="p-6">
                        <!-- Course Name -->
                        <div class="flex items-start justify-between mb-4">
                            <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors">
                                @item.CourseName
                            </h3>
                            <span class="px-3 py-1 rounded-full text-sm font-medium @(item.Score >= 90 ? "bg-green-500/20 text-green-400" : item.Score >= 70 ? "bg-yellow-500/20 text-yellow-400" : "bg-red-500/20 text-red-400")">
                                @(item.Score >= 90 ? "Excellent" : item.Score >= 70 ? "Good" : "Needs Work")
                            </span>
                        </div>

                        <!-- Score Display -->
                        <div class="flex items-center justify-center mb-6">
                            <div class="relative">
                                <svg class="w-32 h-32" viewBox="0 0 100 100">
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="8"/>
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="url(#gradient-@item.Id)" stroke-width="8" stroke-linecap="round" stroke-dasharray="@((double)item.Score * 2.83) 283" transform="rotate(-90 50 50)"/>
                                    <defs>
                                        <linearGradient id="gradient-@item.Id" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#00ffff"/>
                                            <stop offset="100%" stop-color="#ff00ff"/>
                                        </linearGradient>
                                    </defs>
                                </svg>
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <span class="text-3xl font-black gradient-text">@item.Score</span>
                                </div>
                            </div>
                        </div>

                        <!-- Details -->
                        <div class="space-y-3 text-sm">
                            <div class="flex items-center text-gray-400">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                <span>Student ID: <span class="text-white font-medium">@item.StudentId</span></span>
                            </div>
                            <div class="flex items-center text-gray-400">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                <span>@item.GradeDate.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center justify-between mt-6 pt-6 border-t border-white/10">
                            <a asp-action="Details" asp-route-id="@item.Id" class="flex items-center space-x-1 text-cyan-400 hover:text-cyan-300 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                <span>View</span>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="flex items-center space-x-1 text-purple-400 hover:text-purple-300 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                                <span>Edit</span>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="flex items-center space-x-1 text-pink-400 hover:text-pink-300 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                                <span>Delete</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="glass rounded-2xl p-12 text-center">
            <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-cyan-500/20 to-purple-500/20 flex items-center justify-center animate-float">
                <svg class="w-12 h-12 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">No Grades Yet</h3>
            <p class="text-gray-400 mb-6 max-w-md mx-auto">Start tracking academic performance by adding your first grade entry.</p>
            <a asp-action="Create" class="inline-flex items-center space-x-2 px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-purple-500 text-white font-semibold hover:shadow-lg hover:shadow-cyan-500/25 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                <span>Add First Grade</span>
            </a>
        </div>
    }
</div>
