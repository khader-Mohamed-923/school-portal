@{
    ViewData["Title"] = "System Error - Grades";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="text-danger mb-4">
                <i class="bi bi-exclamation-octagon-fill" style="font-size: 5rem;"></i>
            </div>

            <h1 class="fw-bold text-dark mb-2">Grades Service Unavailable</h1>
            <p class="text-muted mb-4">
                The application encountered an internal technical difficulty or failed to sync with the database container.
            </p>

            <div class="alert alert-dark text-white small py-2 mb-4" role="alert">
                <i class="bi bi-shield-slash me-2"></i> Status: 500 Internal Server Error
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Grades" asp-action="Index" class="btn btn-dark px-4 shadow-sm">
                    <i class="bi bi-journal-bookmark-fill me-2"></i> Back to Grades
                </a>
                <button onclick="window.location.reload();" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-clockwise me-2"></i> Retry Connection
                </button>
            </div>
        </div>
    </div>
</div>