<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

<script>
    // Custom styling for validation errors
    $(document).ready(function() {
        // Add styling classes to validation error elements
        $('span.field-validation-error').addClass('text-red-400 text-sm mt-1 block');
        $('input.input-validation-error').addClass('border-red-500 focus:border-red-500 focus:ring-red-500');
        $('input.valid').addClass('border-green-500');
    });
</script>
